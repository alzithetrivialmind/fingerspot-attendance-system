# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# --- Wajib -----------------------------------------------------------------
# API key dari https://developer.fingerspot.io
FINGERSPOT_API_KEY=

# Password database. Pakai huruf dan angka saja karena nilainya masuk ke URL koneksi.
POSTGRES_PASSWORD=

# Kunci token login. Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Kosong = dibuat acak setiap start, semua pengguna harus login ulang setelah restart.
JWT_SECRET_KEY=

# Akun super admin pertama. ADMIN_PASSWORD kosong = dibuat acak, lihat di log aplikasi.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Disarankan ------------------------------------------------------------
# Rahasia di URL webhook: https://domain-anda/webhook/fingerspot?token=<nilai ini>
WEBHOOK_TOKEN=

# --- Opsional --------------------------------------------------------------
APP_NAME=Fingerspot Attendance Hub
APP_PORT=8000
# Asia/Jakarta (WIB), Asia/Makassar (WITA), Asia/Jayapura (WIT)
TIMEZONE=Asia/Jakarta
# Buka layar monitor tanpa login: /monitor?key=<nilai ini>
MONITOR_KEY=
# Backup harian dibuat setelah jam ini (0-23)
BACKUP_HOUR=23
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Hanya bila dijalankan tanpa Docker Compose
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db
# STORAGE_PATH=storage/photos
# BACKUP_DIR=backups
